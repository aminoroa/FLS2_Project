#!/bin/bash --login
#SBATCH --job-name=af3_fls2
#SBATCH --gres=gpu:1
#SBATCH --partition=general-short
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=3:00:00
#SBATCH --output=/mnt/home/aminoroa/FLS2_Project/logs/af3_%A_%a.out
#SBATCH --error=/mnt/home/aminoroa/FLS2_Project/logs/af3_%A_%a.err

set -euo pipefail

INPUT_DIR=/mnt/home/aminoroa/FLS2_Project/Input_data/AF3_Input
OUTPUT_DIR=/mnt/home/aminoroa/FLS2_Project/AF3_Output
MODEL_DIR=/mnt/home/aminoroa/AF3_model_weights
LOG_DIR=/mnt/home/aminoroa/FLS2_Project/logs
TMP_JSON_DIR=/mnt/home/aminoroa/FLS2_Project/tmp_json
AF3_DB_DIR=/mnt/research/common-data/alphafold/database_3

mkdir -p "${LOG_DIR}" "${OUTPUT_DIR}" "${TMP_JSON_DIR}"

export XLA_FLAGS="--xla_disable_hlo_passes=custom-kernel-fusion-rewriter"

mapfile -t JSON_FILES < <(find "${INPUT_DIR}" -maxdepth 1 -type f -name '*.json' | sort)
NUM_FILES=${#JSON_FILES[@]}

if [[ ${NUM_FILES} -eq 0 ]]; then
    echo "No JSON files found in ${INPUT_DIR}"
    exit 1
fi

if [[ -z "${SLURM_ARRAY_TASK_ID:-}" ]]; then
    TOTAL_TASKS=$((NUM_FILES * 3))
    echo "Found ${NUM_FILES} JSON files. Submitting ${TOTAL_TASKS} tasks."
    sbatch --array=0-$((TOTAL_TASKS - 1))%10 "$0"
    exit 0
fi

FILE_INDEX=$(( SLURM_ARRAY_TASK_ID / 3 ))
RUN_NUMBER=$(( SLURM_ARRAY_TASK_ID % 3 + 1 ))
SEED=${RUN_NUMBER}

JSON_FILE="${JSON_FILES[$FILE_INDEX]}"
BASENAME=$(basename "${JSON_FILE}" .json)

TASK_OUTPUT_DIR="${OUTPUT_DIR}/${BASENAME}/run_${RUN_NUMBER}"
TASK_JSON="${TMP_JSON_DIR}/${BASENAME}_run_${RUN_NUMBER}.json"

mkdir -p "${TASK_OUTPUT_DIR}"

python - <<PY
import json
from pathlib import Path

src = Path("${JSON_FILE}")
dst = Path("${TASK_JSON}")

with src.open() as f:
    data = json.load(f)

data["modelSeeds"] = [${SEED}]

with dst.open("w") as f:
    json.dump(data, f, indent=2)
PY

echo "Running ${BASENAME}, run ${RUN_NUMBER}, seed ${SEED}"

${EBROOTALPHAFOLD3}/bin/run_alphafold.py \
    --json_path="${TASK_JSON}" \
    --model_dir="${MODEL_DIR}" \
    --db_dir="${AF3_DB_DIR}" \
    --output_dir="${TASK_OUTPUT_DIR}" \
    --flash_attention_implementation=xla