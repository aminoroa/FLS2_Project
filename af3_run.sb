#!/bin/bash
# ================================================================
# AlphaFold3 Batch Submission Script — FLS2 Project
#
# How to run (from the login node):
#   bash af3_run1.sb
#
# This script auto-detects ALL JSON files in INPUT_DIR and
# submits a SLURM array job (3 tasks running at a time).
# Works for any number of input files — no manual editing needed.
# ================================================================
#SBATCH --job-name=AF3_FLS2
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=80G
#SBATCH --time=08:00:00
#SBATCH --output=/mnt/home/aminoroa/logs/af3_%A_%a.out
#SBATCH --error=/mnt/home/aminoroa/logs/af3_%A_%a.err

INPUT_DIR=/mnt/home/aminoroa/FLS2_Project/Input_data/AF3_Input
OUTPUT_DIR=/mnt/home/aminoroa/FLS2_Project/AF3_Output
MODEL_DIR=/mnt/home/aminoroa/AF3_model_weights
LOG_DIR=/mnt/home/aminoroa/logs

# ----------------------------------------------------------------
# LAUNCHER MODE — runs when you call: bash af3_run1.sb
# (SLURM_ARRAY_TASK_ID is not set outside of a SLURM array job)
# ----------------------------------------------------------------
if [ -z "$SLURM_ARRAY_TASK_ID" ]; then
    mkdir -p "${LOG_DIR}"

    mapfile -t JSON_FILES < <(ls "${INPUT_DIR}"/*.json 2>/dev/null | sort)
    N=${#JSON_FILES[@]}

    if [ "$N" -eq 0 ]; then
        echo "ERROR: No JSON files found in ${INPUT_DIR}"
        exit 1
    fi

    echo "Found ${N} AF3 input file(s)."
    echo "Submitting SLURM array job: tasks 1-${N}, max 3 running at a time..."
    sbatch --array=1-${N}%3 "$0"
    exit 0
fi

# ----------------------------------------------------------------
# WORKER MODE — runs for each SLURM array task
# ----------------------------------------------------------------
mkdir -p "${OUTPUT_DIR}" "${LOG_DIR}"

module purge
module load AlphaFold3/3.0.1-foss-2023a-CUDA-12.4.0-patch20250310

# Select the JSON file corresponding to this array task (1-indexed)
mapfile -t JSON_FILES < <(ls "${INPUT_DIR}"/*.json | sort)
JSON_FILE="${JSON_FILES[$((SLURM_ARRAY_TASK_ID - 1))]}"

if [ -z "$JSON_FILE" ] || [ ! -f "$JSON_FILE" ]; then
    echo "ERROR: No file found for task ID ${SLURM_ARRAY_TASK_ID}"
    exit 1
fi

BASENAME=$(basename "${JSON_FILE}" .json)
TASK_OUTPUT_DIR="${OUTPUT_DIR}/${BASENAME}"
mkdir -p "${TASK_OUTPUT_DIR}"

echo "======================================"
echo "Array Job ID : ${SLURM_ARRAY_JOB_ID}"
echo "Task ID      : ${SLURM_ARRAY_TASK_ID}"
echo "Input file   : ${JSON_FILE}"
echo "Output dir   : ${TASK_OUTPUT_DIR}"
echo "Start time   : $(date)"
echo "======================================"

run_alphafold.py \
    --json_path="${JSON_FILE}" \
    --model_dir="${MODEL_DIR}" \
    --db_dir="${AF3_DB_DIR}" \
    --output_dir="${TASK_OUTPUT_DIR}"

EXIT_CODE=$?
echo "======================================"
echo "Finished: $(date)"
echo "Exit code: ${EXIT_CODE}"
echo "======================================"
exit ${EXIT_CODE}
