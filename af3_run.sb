#!/bin/bash --login
#SBATCH --job-name=af3_fls2
#SBATCH --gres=gpu:1
#SBATCH --partition=general-short
#SBATCH -C intel21
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --output=/mnt/home/aminoroa/logs/af3_%A_%a.out
#SBATCH --error=/mnt/home/aminoroa/logs/af3_%A_%a.err

# ================================================================
# AlphaFold3 Batch Submission Script — FLS2 Project
# ================================================================

set -euo pipefail

# --- User Paths ---
INPUT_DIR=/mnt/home/aminoroa/FLS2_Project/Input_data/AF3_Input
OUTPUT_DIR=/mnt/home/aminoroa/FLS2_Project/AF3_Output
MODEL_DIR=/mnt/home/aminoroa/AF3_model_weights
LOG_DIR=/mnt/home/aminoroa/FLS2_Project/logs

# --- AlphaFold3 Settings ---
export AF3_DB_DIR="/mnt/research/common-data/alphafold/database_3/"

# ----------------------------------------------------------------
# LAUNCHER MODE (Initial Submission)
# ----------------------------------------------------------------
if [ -z "${SLURM_ARRAY_TASK_ID:-}" ]; then
    mkdir -p "${LOG_DIR}"
    
    # Count JSON files
    mapfile -t JSON_FILES < <(ls "${INPUT_DIR}"/*.json 2>/dev/null | sort)
    N=${#JSON_FILES[@]}

    if [ "$N" -eq 0 ]; then
        echo "ERROR: No JSON files found in ${INPUT_DIR}"
        exit 1
    fi

    # MODIFIED: Changed %3 to %5 below
    echo "Found ${N} input files. Submitting array job (1-${N}), max 5 at a time."
    sbatch --array=1-${N}%5 "$0"
    exit 0
fi

# ----------------------------------------------------------------
# WORKER MODE
# ----------------------------------------------------------------

# 1. Environment Setup
module purge
module load AlphaFold3/3.0.1-foss-2023a-CUDA-12.6.0-patch20250310

# Required for V100 GPUs on intel21 nodes
export XLA_FLAGS="${XLA_FLAGS:-} --xla_disable_hlo_passes=custom-kernel-fusion-rewriter"

# 2. Identify this task's file
mapfile -t JSON_FILES < <(ls "${INPUT_DIR}"/*.json | sort)
JSON_FILE="${JSON_FILES[$((SLURM_ARRAY_TASK_ID - 1))]:-}"

if [ -z "$JSON_FILE" ] || [ ! -f "$JSON_FILE" ]; then
    echo "ERROR: No file found for task ID ${SLURM_ARRAY_TASK_ID}"
    exit 1
fi

BASENAME=$(basename "${JSON_FILE}" .json)
TASK_OUTPUT_DIR="${OUTPUT_DIR}/${BASENAME}"

# 3. Skip if already completed
if [ -d "${TASK_OUTPUT_DIR}" ] && [ -n "$(ls -A "${TASK_OUTPUT_DIR}" 2>/dev/null)" ]; then
    echo "Skipping ${BASENAME}: Output already exists."
    exit 0
fi

mkdir -p "${TASK_OUTPUT_DIR}"

# 4. Run AlphaFold3
${EBROOTALPHAFOLD3}/bin/run_alphafold.py \
    --json_path="${JSON_FILE}" \
    --model_dir="${MODEL_DIR}" \
    --db_dir="${AF3_DB_DIR}" \
    --output_dir="${TASK_OUTPUT_DIR}"